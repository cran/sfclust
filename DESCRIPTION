Package: sfclust
Title: Bayesian Spatial Functional Clustering
Version: 1.0.1
Authors@R: c(
    person(c("Erick", "A."), "Chacón-Montalván", ,"erick.chaconmontalvan@kaust.edu.sa", role = c("aut", "cre"),
